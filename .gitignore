# macOS metadata (anywhere in the tree)
.DS_Store

# ESPHome and PlatformIO build output
src/.esphome/
esphome/.esphome/
.pio/

# Local configuration and secrets — never commit these
esphome/secrets.yaml
esphome/local_entities.h
esphome/settings.yaml
home_assistant/*.local.yaml
.vscode/settings.json
# Your own fonts, such as trial or commercial fonts that can't be redistributed
assets/fonts/local/

# Release workflow scratch output
release_artifacts/
release_notes.md

releases/2.5.md
releases/2.7.md

# Python bytecode
__pycache__/
*.pyc
.vscode/extensions.json
.vscode/c_cpp_properties.json
